# Frontend (Vercel/Netlify): URL of the API host, no trailing slash
VITE_API_URL=https://your-api.onrender.com
# API (Render): comma-separated frontend origins allowed to call it
ALLOWED_ORIGIN=https://your-app.vercel.app
# API: folder for stored responses (use a persistent disk if you want to keep them)
DATA_DIR=data
